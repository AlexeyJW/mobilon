generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BonusTransaction {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  // +50 = нарахування
  // -100 = списання
  amount Int

  // Поки optional, тому що в базі вже можуть бути старі записи
  type BonusTransactionType?

  // Старе поле поки залишаємо
  reason String

  // Нове нормальне пояснення операції
  description String?

  // Продаж, через який виникла операція
  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  // Політика, яка діяла в момент операції
  policyId Int?
  policy   BonusPolicy? @relation(fields: [policyId], references: [id])

  // Знімок % на момент операції
  rewardPercentSnapshot Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([purchaseId])
  @@index([policyId])
  @@index([createdAt])
}

model BonusPolicy {
  id Int @id @default(autoincrement())

  // Наприклад 5 = 5%
  rewardPercent Decimal @db.Decimal(5, 2)

  // Максимальна частина покупки,
  // яку дозволено оплатити бонусами.
  // Наприклад 20 = 20%
  maxRedeemPercent Decimal @db.Decimal(5, 2)

  // Мінімальна сума покупки,
  // з якої нараховуються бонуси
  minPurchaseAmount Decimal? @db.Decimal(10, 2)

  // Мінімальна кількість бонусів,
  // яку дозволено використати
  minRedeemPoints Int?

  // Через скільки днів після покупки
  // бонуси можна використовувати
  activationDelayDays Int @default(0)

  // null = бонуси не згорають
  expirationDays Int?

  // Чи нараховувати за ці категорії
  rewardProducts Boolean @default(true)
  rewardServices Boolean @default(true)

  // Чи давати нові бонуси на частину,
  // яка була оплачена старими бонусами
  rewardOnBonusPaidPart Boolean @default(false)

  // Період дії політики
  validFrom DateTime
  validTo   DateTime?

  createdAt DateTime @default(now())

  transactions BonusTransaction[]
  purchases    Purchase[]

  @@index([validFrom])
  @@index([validTo])
}

model Customer {
  id    Int    @id @default(autoincrement())
  name  String
  phone String @unique

  visits Int @default(0)
  points Int @default(0)

  notes String?

  loyaltyActive  Boolean @default(false)
  cardToken      String? @unique
  telegramChatId String?

  active    Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  requests          Request[]
  bonusTransactions BonusTransaction[]
  purchases         Purchase[]

  @@index([active])
}

enum BonusTransactionType {
  PURCHASE_REWARD
  PURCHASE_PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  EXPIRED
  INITIAL_BALANCE
}

model Purchase {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  // Повна сума фіскального чека
  totalAmount Decimal @db.Decimal(10, 2)

  // Скільки бонусів використали
  bonusUsed Int @default(0)

  // Скільки реально було сплачено після бонусів
  paidAmount Decimal @db.Decimal(10, 2)

  // Скільки бонусів отримав клієнт
  bonusEarned Int @default(0)

  // Політика, яка діяла на момент покупки
  policyId Int?
  policy   BonusPolicy? @relation(fields: [policyId], references: [id])

  // Зберігаємо параметри розрахунку на момент продажу
  rewardPercentSnapshot    Decimal? @db.Decimal(5, 2)
  maxRedeemPercentSnapshot Decimal? @db.Decimal(5, 2)

  // Дані фіскального чека
  fiscalReceiptNumber String?
  fiscalDeviceNumber  String?
  fiscalReceiptDate   DateTime?
  fiscalReceiptUrl    String?

  source PurchaseSource @default(MANUAL)
  status PurchaseStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bonusTransactions BonusTransaction[]
  items             PurchaseLine[]

  // Один фіскальний чек не можна зарахувати двічі
  @@unique([fiscalDeviceNumber, fiscalReceiptNumber])
  @@index([customerId])
  @@index([createdAt])
  @@index([policyId])
}

enum PurchaseSource {
  MANUAL
  FISCAL_QR
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PurchaseLine {
  id Int @id @default(autoincrement())

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  name String

  type PurchaseLineType

  quantity Decimal @db.Decimal(10, 3)

  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@index([serviceId])
}

enum PurchaseLineType {
  PRODUCT
  SERVICE
  OTHER
}

model Request {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  description String
  createdAt   DateTime  @default(now())
  status      String    @default("new")
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model PurchaseItem {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(1)
  supplier  String?
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Product {
  id Int @id @default(autoincrement())

  name String

  brand    String
  brandId  Int?
  brandRef Brand? @relation(fields: [brandId], references: [id])

  category    String
  categoryId  Int?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  slug             String? @unique
  shortDescription String?
  description      String?

  buyPrice  Float
  sellPrice Float
  quantity  Int

  imageUrl String?
  imageId  String?

  isFeatured Boolean @default(false)
  isPopular  Boolean @default(false)
  isNew      Boolean @default(false)
  isSale     Boolean @default(false)

  active Boolean @default(true)

  sortOrder     Int  @default(0)
  featuredOrder Int?

  specifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  purchaseLines PurchaseLine[]

  @@index([brandId])
  @@index([categoryId])
  @@index([active, quantity])
}

model Brand {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  active Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  parentId Int?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  products       Product[]
  specifications CategorySpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SpecificationType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model Specification {
  id Int @id @default(autoincrement())

  name String
  key  String @unique

  type SpecificationType
  unit String?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  options    SpecificationOption[]
  categories CategorySpecification[]
  products   ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecificationOption {
  id Int @id @default(autoincrement())

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  label String
  value String

  sortOrder Int @default(0)

  productSpecifications ProductSpecification[]

  createdAt DateTime @default(now())

  @@unique([specificationId, value])
  @@index([specificationId])
}

model CategorySpecification {
  id Int @id @default(autoincrement())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  required   Boolean @default(false)
  filterable Boolean @default(false)

  sortOrder Int @default(0)

  @@unique([categoryId, specificationId])
  @@index([categoryId])
  @@index([specificationId])
}

model ProductSpecification {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  optionId Int?
  option   SpecificationOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, specificationId])
  @@index([productId])
  @@index([specificationId])
  @@index([optionId])
}

model Order {
  id Int @id @default(autoincrement())

  customer String
  phone    String

  productName String
  quantity    Int

  comment String?

  status String @default("new")

  createdAt DateTime @default(now())
}

model Lead {
  id Int @id @default(autoincrement())

  customerName String

  phone String

  city String?

  comment String?

  productId Int?

  product Product? @relation(fields: [productId], references: [id])

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId Int?
}

enum LeadStatus {
  NEW

  PROCESSING

  DONE

  CANCELED
}

model StorePhoto {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  imageUrl    String
  publicId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  position     String?
  photo        String?
  active       Boolean  @default(true)
  showOnAbout  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model Session {
  id Int @id @default(autoincrement())

  tokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
}

model ServiceCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id Int @id @default(autoincrement())

  name        String
  slug        String? @unique
  description String?

  seoText         String?
  duration        String?
  whatIncluded    String?
  metaTitle       String?
  metaDescription String?

  price     Decimal @db.Decimal(10, 2)
  priceFrom Boolean @default(false)

  image       String?
  category    String?
  categoryId  Int?
  categoryRef ServiceCategory? @relation(fields: [categoryId], references: [id])

  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  purchaseLines PurchaseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
