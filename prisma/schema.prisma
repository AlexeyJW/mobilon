generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BonusTransaction {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  amount Int
  reason String

  createdAt DateTime @default(now())
}

model Customer {
  id                Int                @id @default(autoincrement())
  name              String
  phone             String             @unique
  visits            Int                @default(0)
  points            Int                @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  requests          Request[]
  bonusTransactions BonusTransaction[]
}

model Request {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  description String
  createdAt   DateTime  @default(now())
  status      String    @default("new")
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model PurchaseItem {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(1)
  supplier  String?
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Product {
  id Int @id @default(autoincrement())

  name             String
  brand            String
  category         String
  slug             String? @unique
  shortDescription String?
  description      String?

  buyPrice  Float
  sellPrice Float
  quantity  Int

  imageUrl String?
  imageId  String?

  isFeatured Boolean @default(false)
  isPopular  Boolean @default(false)
  isNew      Boolean @default(false)
  isSale     Boolean @default(false)

  active Boolean @default(true)

  sortOrder     Int      @default(0)
  featuredOrder Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  leads         Lead[]
}

model Order {
  id Int @id @default(autoincrement())

  customer String
  phone    String

  productName String
  quantity    Int

  comment String?

  status String @default("new")

  createdAt DateTime @default(now())
}

model Lead {
  id Int @id @default(autoincrement())

  customerName String

  phone String

  city String?

  comment String?

  productId Int?

  product Product? @relation(fields: [productId], references: [id])

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId Int?
}

enum LeadStatus {
  NEW

  PROCESSING

  DONE

  CANCELED
}

model StorePhoto {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  imageUrl    String
  publicId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
}

model User {
  id           Int      @id @default(autoincrement())

  name         String
  username     String   @unique
  passwordHash String

  role         UserRole @default(MANAGER)
  position     String   @default("Менеджер")

  active       Boolean  @default(true)
  showOnAbout  Boolean  @default(false)
  photo        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}