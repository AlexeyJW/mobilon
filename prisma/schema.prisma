generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BonusTransaction {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  amount Int
  reason String

  createdAt DateTime @default(now())
}

model Customer {
  id                Int                @id @default(autoincrement())
  name              String
  phone             String             @unique
  visits            Int                @default(0)
  points            Int                @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  requests          Request[]
  bonusTransactions BonusTransaction[]
}

model Request {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  description String
  createdAt   DateTime  @default(now())
  status      String    @default("new")
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model PurchaseItem {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(1)
  supplier  String?
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Product {
  id Int @id @default(autoincrement())

  name String

  brand    String
  brandId  Int?
  brandRef Brand? @relation(fields: [brandId], references: [id])

  category    String
  categoryId  Int?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  slug             String? @unique
  shortDescription String?
  description      String?

  buyPrice  Float
  sellPrice Float
  quantity  Int

  imageUrl String?
  imageId  String?

  isFeatured Boolean @default(false)
  isPopular  Boolean @default(false)
  isNew      Boolean @default(false)
  isSale     Boolean @default(false)

  active Boolean @default(true)

  sortOrder     Int  @default(0)
  featuredOrder Int?

  specifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([brandId])
  @@index([categoryId])
  @@index([active, quantity])
}

model Brand {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  active Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  parentId Int?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  products       Product[]
  specifications CategorySpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SpecificationType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model Specification {
  id Int @id @default(autoincrement())

  name String
  key  String @unique

  type SpecificationType
  unit String?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  options    SpecificationOption[]
  categories CategorySpecification[]
  products   ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecificationOption {
  id Int @id @default(autoincrement())

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  label String
  value String

  sortOrder Int @default(0)

  productSpecifications ProductSpecification[]

  createdAt DateTime @default(now())

  @@unique([specificationId, value])
  @@index([specificationId])
}

model CategorySpecification {
  id Int @id @default(autoincrement())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  required   Boolean @default(false)
  filterable Boolean @default(false)

  sortOrder Int @default(0)

  @@unique([categoryId, specificationId])
  @@index([categoryId])
  @@index([specificationId])
}

model ProductSpecification {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  specificationId Int
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  optionId Int?
  option   SpecificationOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, specificationId])
  @@index([productId])
  @@index([specificationId])
  @@index([optionId])
}

model Order {
  id Int @id @default(autoincrement())

  customer String
  phone    String

  productName String
  quantity    Int

  comment String?

  status String @default("new")

  createdAt DateTime @default(now())
}

model Lead {
  id Int @id @default(autoincrement())

  customerName String

  phone String

  city String?

  comment String?

  productId Int?

  product Product? @relation(fields: [productId], references: [id])

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId Int?
}

enum LeadStatus {
  NEW

  PROCESSING

  DONE

  CANCELED
}

model StorePhoto {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  imageUrl    String
  publicId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  position     String?
  photo        String?
  active       Boolean  @default(true)
  showOnAbout  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model Session {
  id Int @id @default(autoincrement())

  tokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
}

model ServiceCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id Int @id @default(autoincrement())

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  priceFrom   Boolean @default(false)

  image       String?
  category    String?
  categoryId  Int?
  categoryRef ServiceCategory? @relation(fields: [categoryId], references: [id])

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
